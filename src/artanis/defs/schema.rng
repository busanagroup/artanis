        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <!-- anonymous3 -->
    <rng:define name="column-attr">
        <rng:optional>
            <rng:attribute name="required">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="multiple">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="colSpan">
                <rng:choice>
                    <rng:data type="int"/>
                    <rng:data type="string">
                        <rng:param name="pattern">(\d+)(,(\d+))*</rng:param>
                    </rng:data>
                </rng:choice>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="widget">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="selection">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="domain">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="target-name">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="target">
