                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonlyIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="MenubarMenuDivider">
        <rng:group>
            <rng:ref name="if-condition"/>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="depends">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hideIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="MenubarMenu">
        <rng:group>
            <rng:ref name="if-condition"/>
            <rng:oneOrMore>
                <rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="item">
                            <rng:ref name="MenubarMenuItem"/>
                        </rng:element>
                    </rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="divider">
                            <rng:ref name="MenubarMenuDivider"/>
                        </rng:element>
                    </rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="menu">
                            <rng:ref name="MenubarMenu"/>
                        </rng:element>
                    </rng:choice>
                </rng:choice>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:attribute name="title">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="icon">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="Menubar">
        <rng:oneOrMore>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="menu">
                    <rng:ref name="MenubarMenu"/>
                </rng:element>
            </rng:choice>
        </rng:oneOrMore>
    </rng:define>

    <rng:define name="GridWidgets">
        <rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="field">
                    <rng:ref name="panel-field-attr"/>
                    <rng:optional>
                        <rng:element name="grid">
                            <rng:ref name="grid-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:element name="form">
                            <rng:ref name="form-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                            <rng:ref name="form-elements"/>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="aggregate">
                            <rng:choice>
                                <rng:value type="string">avg</rng:value>
                                <rng:value type="string">min</rng:value>
                                <rng:value type="string">max</rng:value>
                                <rng:value type="string">sum</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="sortable">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="massUpdate">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="canSelect">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="edit-window">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="summary-view">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="showTitle">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="height">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="depends">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-call-onSave">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-copy">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-reload">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-export">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-labels">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-icons">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-bars">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="button">
                    <rng:ref name="GridButton"/>
                </rng:element>
            </rng:choice>
        </rng:choice>
    </rng:define>

    <rng:define name="ExtendGridItems">
        <rng:choice>
            <rng:ref name="GridWidgets"/>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="toolbar">
                    <rng:ref name="Toolbar"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="menubar">
                    <rng:ref name="Menubar"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="menu">
                    <rng:ref name="MenubarMenu"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="item">
                    <rng:ref name="MenubarMenuItem"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="divider">
                    <rng:ref name="MenubarMenuDivider"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="help">
                    <rng:ref name="Help"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="hilite">
                    <rng:ref name="Hilite"/>
                </rng:element>
            </rng:choice>
        </rng:choice>
    </rng:define>

    <rng:define name="grid-elements">
        <rng:oneOrMore>
            <rng:choice>
                <rng:element name="field">
                    <rng:ref name="panel-field-attr"/>
                    <rng:optional>
                        <rng:element name="grid">
                            <rng:ref name="grid-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                            <rng:ref name="grid-elements"/>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:element name="form">
                            <rng:ref name="form-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                            <rng:ref name="form-elements"/>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="aggregate">
                            <rng:choice>
                                <rng:value type="string">avg</rng:value>
                                <rng:value type="string">min</rng:value>
                                <rng:value type="string">max</rng:value>
                                <rng:value type="string">sum</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="sortable">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="massUpdate">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="canSelect">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="edit-window">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="summary-view">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="showTitle">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="height">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="depends">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-call-onSave">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-copy">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-reload">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-export">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-labels">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-icons">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-bars">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
                <rng:element name="toolbar">
                    <rng:ref name="Toolbar"/>
                </rng:element>
                <rng:element name="button">
                    <rng:ref name="GridButton"/>
                </rng:element>
                <rng:element name="help">
                    <rng:ref name="Help"/>
                </rng:element>
                <rng:element name="menubar">
                    <rng:ref name="Menubar"/>
                </rng:element>
                <rng:element name="hilite">
                    <rng:ref name="Hilite"/>
                </rng:element>
                <rng:element name="extend">
                    <rng:optional>
                        <rng:attribute name="if-module">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="if-feature">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="target">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:oneOrMore>
                        <rng:choice>
                            <rng:element name="attribute">
                                <rng:ref name="ExtendAttribute"/>
                            </rng:element>
                            <rng:element name="insert">
                                <rng:attribute name="position">
                                    <rng:choice>
                                        <rng:value type="string">before</rng:value>
                                        <rng:value type="string">after</rng:value>
                                        <rng:value type="string">inside</rng:value>
                                    </rng:choice>
                                </rng:attribute>
                                <rng:oneOrMore>
                                    <rng:ref name="ExtendGridItems"/>
                                </rng:oneOrMore>
                            </rng:element>
                            <rng:element name="replace">
                                <rng:zeroOrMore>
                                    <rng:ref name="ExtendGridItems"/>
                                </rng:zeroOrMore>
                            </rng:element>
                            <rng:element name="move">
                                <rng:attribute name="position">
                                    <rng:choice>
                                        <rng:value type="string">before</rng:value>
                                        <rng:value type="string">after</rng:value>
                                        <rng:value type="string">inside</rng:value>
                                    </rng:choice>
                                </rng:attribute>
                                <rng:attribute name="source">
                                    <rng:data type="string"/>
                                </rng:attribute>
                            </rng:element>
                        </rng:choice>
                    </rng:oneOrMore>
                </rng:element>
            </rng:choice>
        </rng:oneOrMore>
    </rng:define>

    <rng:define name="grid">
        <rng:element name="grid">
            <rng:ref name="CommonAttributes"/>
            <rng:ref name="AdvanceSearchAttributes"/>
            <rng:optional>
                <rng:attribute name="extension">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:ref name="grid-attr"/>
            <rng:ref name="grid-elements"/>
        </rng:element>
    </rng:define>

    <rng:define name="named-layout-attr">
        <rng:ref name="layout-attr"/>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="search-filters">
        <rng:element name="search-filters">
            <rng:ref name="named-layout-attr"/>
            <rng:attribute name="service">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:zeroOrMore>
                <rng:element name="field">
                    <rng:optional>
                        <rng:attribute name="selection">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="if">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="hidden">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="title">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
            <rng:zeroOrMore>
                <rng:element name="filter">
                    <rng:ref name="if-condition"/>
                    <rng:element name="domain">
                        <rng:data type="string"/>
                    </rng:element>
                    <rng:zeroOrMore>
                        <rng:element name="context">
                            <rng:attribute name="value">
                                <rng:data type="string"/>
                            </rng:attribute>
                            <rng:attribute name="name">
                                <rng:data type="string"/>
                            </rng:attribute>
                        </rng:element>
                    </rng:zeroOrMore>
                    <rng:optional>
                        <rng:attribute name="name">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="title">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="form">
        <rng:element name="form">
            <rng:ref name="CommonAttributes"/>
            <rng:ref name="AdvanceSearchAttributes"/>
            <rng:ref name="form-attr"/>
            <rng:ref name="form-elements"/>
        </rng:element>
    </rng:define>

    <rng:define name="artanis_data">
        <rng:element name="artanis">
            <rng:oneOrMore>
                <rng:choice>
                    <rng:ref name="grid"/>
                    <rng:ref name="form"/>
                    <rng:ref name="menu"/>
                    <rng:ref name="search-filters"/>
                    <rng:ref name="action-view"/>
                    <rng:ref name="action-menu"/>
                    <rng:ref name="action-validate"/>
                    <rng:ref name="action-condition"/>
                    <rng:ref name="action-record"/>
                    <rng:ref name="action-attrs"/>
                    <rng:ref name="action-method"/>
                    <rng:ref name="action-script"/>
                    <rng:ref name="action-ws"/>
                    <rng:ref name="action-import"/>
                    <rng:ref name="action-export"/>
                    <rng:ref name="action-group"/>
                    <rng:ref name="action-report"/>
                </rng:choice>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:start>
        <rng:ref name="artanis_data"/>
    </rng:start>
</rng:grammar>
