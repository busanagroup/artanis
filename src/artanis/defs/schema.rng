    <rng:define name="calendar">
        <rng:element name="calendar">
            <rng:ref name="layout-attr"/>
            <rng:zeroOrMore>
                <rng:element name="hilite">
                    <rng:optional>
                        <rng:attribute name="styles">
                            <rng:data type="string">
                                <rng:param name="pattern">
                                    (fill|outline|stripe|strike|fade)(\W+(fill|outline|stripe|strike|fade))*
                                </rng:param>
                            </rng:data>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="if">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
            <rng:oneOrMore>
                <rng:element name="field">
                    <rng:ref name="field-status-attr"/>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="colSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="showTitle">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="hidden">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="readonly">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:element name="template">
                    <rng:data type="string"/>
                </rng:element>
            </rng:optional>
            <rng:ref name="ArtanisAttributes"/>
            <rng:attribute name="eventStart">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="eventStop">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="eventLength">
                    <rng:data type="integer">
                        <rng:param name="minInclusive">1</rng:param>
                        <rng:param name="maxInclusive">24</rng:param>
                    </rng:data>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onChange">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onDelete">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colorBy">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="mode">
                    <rng:choice>
                        <rng:value type="string">week</rng:value>
                        <rng:value type="string">month</rng:value>
                        <rng:value type="string">day</rng:value>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="canNew">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="canDelete">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
