        </rng:optional>
        <rng:optional>
            <rng:attribute name="canArchive">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="canMove">
                <rng:data type="boolean"/>
            </rng:attribute>
