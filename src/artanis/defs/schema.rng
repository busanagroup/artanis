                                    </rng:oneOrMore>
                                </rng:element>
                                <rng:element name="move">
                                    <rng:attribute name="position">
                                        <rng:choice>
                                            <rng:value type="string">before</rng:value>
                                            <rng:value type="string">after</rng:value>
                                            <rng:value type="string">inside</rng:value>
                                        </rng:choice>
                                    </rng:attribute>
                                    <rng:attribute name="source">
                                        <rng:data type="string"/>
                                    </rng:attribute>
                                </rng:element>
                            </rng:choice>
                        </rng:oneOrMore>
                    </rng:element>
                </rng:choice>
            </rng:oneOrMore>
            <rng:group>
                <rng:optional>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="toolbar">
                            <rng:ref name="Toolbar"/>
                        </rng:element>
                    </rng:choice>
                </rng:optional>
                <rng:optional>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="menubar">
                            <rng:ref name="Menubar"/>
                        </rng:element>
                    </rng:choice>
                </rng:optional>
                <rng:zeroOrMore>
                    <rng:choice>
                        <rng:choice>
                            <rng:notAllowed/>
                            <rng:element name="help">
                                <rng:ref name="Help"/>
                            </rng:element>
                        </rng:choice>
                        <rng:choice>
                            <rng:element name="panel">
                                <rng:ref name="Panel"/>
                            </rng:element>
                        </rng:choice>
                        <rng:choice>
                            <rng:element name="panel-include">
                                <rng:ref name="FormInclude"/>
                            </rng:element>
                        </rng:choice>
                        <rng:choice>
                            <rng:notAllowed/>
                            <rng:element name="panel-dashlet">
                                <rng:ref name="PanelDashlet"/>
                            </rng:element>
                        </rng:choice>
                        <rng:choice>
                            <rng:notAllowed/>
                            <rng:element name="panel-related">
                                <rng:ref name="PanelRelated"/>
                            </rng:element>
                        </rng:choice>
                        <rng:choice>
                            <rng:notAllowed/>
                            <rng:element name="panel-stack">
