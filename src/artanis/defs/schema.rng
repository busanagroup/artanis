            </rng:element>
            <rng:oneOrMore>
                <rng:element name="select">
                    <rng:optional>
                        <rng:attribute name="distinct">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="limit">
                            <rng:data type="int"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="grid-view">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="form-view">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="if">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="orderBy">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="selected">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="view-title">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="title">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="model">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:oneOrMore>
                        <rng:element name="field">
                            <rng:optional>
                                <rng:attribute name="selection"/>
                            </rng:optional>
                            <rng:optional>
                                <rng:attribute name="enum-type"/>
                            </rng:optional>
                            <rng:attribute name="as">
                                <rng:data type="string"/>
                            </rng:attribute>
                            <rng:attribute name="name">
                                <rng:data type="string"/>
                            </rng:attribute>
                        </rng:element>
                    </rng:oneOrMore>
                    <rng:element name="where">
                        <rng:ref name="where-attr"/>
                        <rng:optional>
                            <rng:attribute name="if">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                </rng:element>
            </rng:oneOrMore>
            <rng:zeroOrMore>
                <rng:element name="action-menu">
                    <rng:ref name="ActionMenuItem"/>
                </rng:element>
            </rng:zeroOrMore>
            <rng:attribute name="limit">
                <rng:data type="int"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="search-form">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="ActionMenuItem">
        <rng:group>
            <rng:ref name="menu-attr"/>
            <rng:optional>
                <rng:attribute name="icon">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="groups">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="category">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="selection">
        <rng:element name="selection">
            <rng:optional>
                <rng:attribute name="id">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="option">
                    <rng:attribute name="value">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="icon">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="color">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="order">
                            <rng:data type="int"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="hidden">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="data-description">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="data-domain">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="data-grid">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="data-form">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="action-menu">
        <rng:element name="action-menu">
            <rng:ref name="ActionMenuItem"/>
        </rng:element>
    </rng:define>

    <!-- anonymous25 -->
    <rng:define name="module-attr">
        <rng:optional>
            <rng:attribute name="if-module">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="id">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <!-- anonymous20 -->
    <rng:define name="if-attr">
        <rng:optional>
            <rng:attribute name="if">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <!-- anonymous9 -->
    <rng:define name="service-attr">
        <rng:ref name="module-attr"/>
        <rng:optional>
            <rng:attribute name="service">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="action-condition">
        <rng:element name="action-condition">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="check">
                    <rng:ref name="if-attr"/>
                    <rng:optional>
                        <rng:attribute name="field">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="error">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="action-script">
        <rng:element name="action-script">
            <rng:ref name="service-attr"/>
            <rng:element name="script">
                <rng:attribute name="language">
                    <rng:choice>
                        <rng:value type="string">python</rng:value>
                    </rng:choice>
                </rng:attribute>
                <rng:optional>
                    <rng:attribute name="transactional">
                        <rng:data type="boolean"/>
                    </rng:attribute>
                </rng:optional>
                <rng:data type="string"/>
            </rng:element>
        </rng:element>
    </rng:define>

    <rng:define name="action-ws">
        <rng:element name="action-ws">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="action">
                    <rng:ref name="common-action-attr"/>
                    <rng:attribute name="template">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="engine">
                            <rng:choice>
                                <rng:value type="string">python</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="connect-timeout">
                    <rng:data type="int"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="read-timeout">
                    <rng:data type="int"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-import">
        <rng:element name="action-import">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="import">
                    <rng:optional>
                        <rng:attribute name="name">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="provider">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="file">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:oneOrMore>
            <rng:attribute name="config">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:element>
    </rng:define>

    <rng:define name="action-export">
        <rng:element name="action-export">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="export">
                    <rng:ref name="if-attr"/>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="template">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="engine">
                            <rng:choice>
                                <rng:value type="string">python</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="attachment">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-report">
        <rng:element name="action-report">
            <rng:ref name="service-attr"/>
            <rng:zeroOrMore>
                <rng:element name="param">
                    <rng:ref name="ActContext"/>
                </rng:element>
            </rng:zeroOrMore>
            <rng:attribute name="design">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:attribute name="output">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="format">
                    <rng:choice>
                        <rng:value type="string">xlsx</rng:value>
                        <rng:value type="string">pdf</rng:value>
                        <rng:value type="string">doc</rng:value>
                        <rng:value type="string">html</rng:value>
                        <rng:value type="string">xls</rng:value>
                        <rng:value type="string">odt</rng:value>
                        <rng:value type="string">docx</rng:value>
                        <rng:value type="string">ods</rng:value>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="attachment">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="artanis_data">
        <rng:element name="artanis">
            <rng:oneOrMore>
                <rng:choice>
                    <rng:ref name="grid"/>
                    <rng:ref name="form"/>
                    <rng:ref name="tree"/>
                    <rng:ref name="calendar"/>
                    <rng:ref name="gantt"/>
                    <rng:ref name="kanban"/>
                    <rng:ref name="chart"/>
                    <rng:ref name="dashboard"/>
                    <rng:ref name="search"/>
                    <rng:ref name="search-filters"/>
                    <rng:ref name="menu"/>
                    <rng:ref name="selection"/>
                    <rng:ref name="action-menu"/>
                    <rng:ref name="action-validate"/>
                    <rng:ref name="action-condition"/>
                    <rng:ref name="action-record"/>
                    <rng:ref name="action-attrs"/>
                    <rng:ref name="action-method"/>
                    <rng:ref name="action-view"/>
                    <rng:ref name="action-script"/>
                    <rng:ref name="action-ws"/>
                    <rng:ref name="action-import"/>
                    <rng:ref name="action-export"/>
                    <rng:ref name="action-group"/>
                    <rng:ref name="action-report"/>
                </rng:choice>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:start>
        <rng:ref name="artanis_data"/>
    </rng:start>
</rng:grammar>