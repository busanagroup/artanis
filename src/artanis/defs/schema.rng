        </rng:optional>
        <rng:optional>
            <rng:attribute name="match">
                <rng:choice>
                    <rng:value type="string">all</rng:value>
                    <rng:value type="string">any</rng:value>
                </rng:choice>
            </rng:attribute>
        </rng:optional>
        <rng:zeroOrMore>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="input">
                    <rng:optional>
                        <rng:attribute name="expr">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="if">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="matchStyle">
                            <rng:choice>
                                <rng:value type="string">greaterOrEqual</rng:value>
                                <rng:value type="string">contains</rng:value>
                                <rng:value type="string">equals</rng:value>
                                <rng:value type="string">lessThan</rng:value>
                                <rng:value type="string">endsWith</rng:value>
                                <rng:value type="string">notEquals</rng:value>
                                <rng:value type="string">lessOrEqual</rng:value>
                                <rng:value type="string">startsWith</rng:value>
                                <rng:value type="string">greaterThan</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="field">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:choice>
        </rng:zeroOrMore>
        <rng:zeroOrMore>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="where">
                    <rng:ref name="where-attr"/>
                    <rng:optional>
                        <rng:attribute name="showArchived">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:choice>
        </rng:zeroOrMore>
    </rng:define>

    <rng:define name="ResponsiveNumber">
        <rng:choice>
            <rng:data type="int"/>
            <rng:data type="string">
                <rng:param name="pattern">(\d+)(,(\d+))*</rng:param>
            </rng:data>
        </rng:choice>
    </rng:define>

