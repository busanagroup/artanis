            </rng:optional>
            <rng:zeroOrMore>
                <rng:element name="context">
                    <rng:ref name="ActContext"/>
                </rng:element>
            </rng:zeroOrMore>
            <rng:attribute name="title">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="icon">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
