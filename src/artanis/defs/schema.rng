                                </rng:attribute>
                            </rng:optional>
                            <rng:optional>
                                <rng:attribute name="x-field">
                                    <rng:notAllowed/>
                                </rng:attribute>
                            </rng:optional>
                            <rng:optional>
                                <rng:attribute name="css">
