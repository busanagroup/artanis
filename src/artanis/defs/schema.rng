<?xml version="1.0" encoding="UTF-8"?>
<rng:grammar xmlns:rng="http://relaxng.org/ns/structure/1.0"
             datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

    <rng:define name="CommonAttributes">
        <rng:optional>
            <rng:attribute name="x-json-model">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="editable">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="service">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="AdvanceSearchAttributes">
        <rng:optional>
            <rng:attribute name="freeSearch">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="customSearch">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <!-- anonymous15 -->
    <rng:define name="css-height">
        <rng:data type="string">
            <rng:param name="pattern">\d+(%|px|pt|em)?</rng:param>
        </rng:data>
    </rng:define>

    <rng:define name="ActContext">
        <rng:ref name="action-field-attr"/>
    </rng:define>

    <!-- anonymous21 -->
    <rng:define name="css-width">
        <rng:data type="string">
            <rng:param name="pattern">(\*)|(\d+(%|px|em)?)</rng:param>
        </rng:data>
    </rng:define>

    <rng:define name="if-attr">
        <rng:optional>
            <rng:attribute name="if">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="ActionMenuItem">
        <rng:ref name="menu-attr"/>
        <rng:optional>
            <rng:attribute name="icon">
                <rng:notAllowed/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="category">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="service-attr">
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="service">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="title">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="menu-attr">
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="title">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="icon">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="key">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="hidden">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="mode">
                <rng:choice>
                    <rng:value type="string">desktop</rng:value>
                    <rng:value type="string">mobile</rng:value>
                </rng:choice>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="icon-background">
                <rng:choice>
                    <rng:choice>
                        <rng:value type="string">pink</rng:value>
                        <rng:value type="string">green</rng:value>
                        <rng:value type="string">bluegrey</rng:value>
                        <rng:value type="string">deeporange</rng:value>
                        <rng:value type="string">lime</rng:value>
                        <rng:value type="string">yellow</rng:value>
                        <rng:value type="string">black</rng:value>
                        <rng:value type="string">violet</rng:value>
                        <rng:value type="string">teal</rng:value>
                        <rng:value type="string">amber</rng:value>
                        <rng:value type="string">lightgreen</rng:value>
                        <rng:value type="string">brown</rng:value>
                        <rng:value type="string">deeppurple</rng:value>
                        <rng:value type="string">cyan</rng:value>
                        <rng:value type="string">grey</rng:value>
                        <rng:value type="string">red</rng:value>
                        <rng:value type="string">orange</rng:value>
                        <rng:value type="string">blue</rng:value>
                        <rng:value type="string">lightblue</rng:value>
                        <rng:value type="string">white</rng:value>
                        <rng:value type="string">olive</rng:value>
                        <rng:value type="string">purple</rng:value>
                        <rng:value type="string">indigo</rng:value>
                    </rng:choice>
                    <rng:data type="string">
                        <rng:param name="pattern">#[\dA-Fa-f]{6}([\dA-Fa-f][\dA-Fa-f])?</rng:param>
                    </rng:data>
                </rng:choice>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="action">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="order">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="left">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="hidden">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="tag">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="tag-count">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="tag-get">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="tag-style">
                <rng:choice>
                    <rng:value type="string">important</rng:value>
                    <rng:value type="string">inverse</rng:value>
                    <rng:value type="string">default</rng:value>
                    <rng:value type="string">success</rng:value>
                    <rng:value type="string">warning</rng:value>
                    <rng:value type="string">info</rng:value>
                </rng:choice>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="menuitem">
        <rng:element name="item">
            <rng:ref name="menu-attr"/>
            <rng:zeroOrMore>
                <rng:choice>
                    <rng:text/>
                    <rng:ref name="menuitem"/>
                </rng:choice>
            </rng:zeroOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="menu">
        <rng:element name="menu">
            <rng:attribute name="name"/>
            <rng:oneOrMore>
                <rng:choice>
                    <rng:text/>
                    <rng:ref name="menuitem"/>
                </rng:choice>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="view-attr">
        <rng:attribute name="type">
            <rng:choice>
                <rng:value type="string">calendar</rng:value>
                <rng:value type="string">card</rng:value>
                <rng:value type="string">search-filter</rng:value>
                <rng:value type="string">custom</rng:value>
                <rng:value type="string">tree</rng:value>
                <rng:value type="string">gantt</rng:value>
                <rng:value type="string">search</rng:value>
                <rng:value type="string">form</rng:value>
                <rng:value type="string">grid</rng:value>
                <rng:value type="string">kanban</rng:value>
                <rng:value type="string">html</rng:value>
                <rng:value type="string">chart</rng:value>
                <rng:value type="string">dashboard</rng:value>
            </rng:choice>
        </rng:attribute>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="action-attr">
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="service">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="title">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="type">
            <rng:choice>
                <rng:value type="string">calendar</rng:value>
                <rng:value type="string">cards</rng:value>
                <rng:value type="string">search-filters</rng:value>
                <rng:value type="string">custom</rng:value>
                <rng:value type="string">tree</rng:value>
                <rng:value type="string">gantt</rng:value>
                <rng:value type="string">search</rng:value>
                <rng:value type="string">form</rng:value>
                <rng:value type="string">grid</rng:value>
                <rng:value type="string">kanban</rng:value>
                <rng:value type="string">html</rng:value>
                <rng:value type="string">chart</rng:value>
                <rng:value type="string">dashboard</rng:value>
            </rng:choice>
        </rng:attribute>
        <rng:oneOrMore>
            <rng:element name="view">
                <rng:ref name="view-attr"/>
            </rng:element>
        </rng:oneOrMore>
    </rng:define>

    <rng:define name="action-view">
        <rng:element name="action-view">
            <rng:zeroOrMore>
                <rng:element name="action">
                    <rng:ref name="action-attr"/>
                </rng:element>
            </rng:zeroOrMore>
            <rng:zeroOrMore>
                <rng:element name="view-param">
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="value">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="action-menu">
        <rng:element name="action-menu">
            <rng:ref name="ActionMenuItem"/>
        </rng:element>
    </rng:define>

    <rng:define name="error-attr">
        <rng:ref name="if-attr"/>
        <rng:attribute name="message">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="action">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="confirm-btn-title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="cancel-btn-title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="action-validate">
        <rng:element name="action-validate">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:choice>
                    <rng:element name="error">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                    <rng:element name="alert">
                        <rng:ref name="error-attr"/>
                    </rng:element>
                    <rng:element name="info">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="action">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                    <rng:element name="notify">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="action">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="confirm-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                </rng:choice>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="action-condition">
        <rng:element name="action-condition">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="check">
                    <rng:ref name="if-attr"/>
                    <rng:optional>
                        <rng:attribute name="field">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="error">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="module-attr">
        <rng:optional>
            <rng:attribute name="if-module">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="action-field-attr">
        <rng:ref name="if-attr"/>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="expr">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="copy">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="action-record">
        <rng:element name="action-record">
            <rng:ref name="module-attr"/>
            <rng:attribute name="service">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="field">
                    <rng:ref name="action-field-attr"/>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="search">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="ref">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="copy">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="saveIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-attrs">
        <rng:element name="action-attrs">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="attribute">
                    <rng:ref name="if-attr"/>
                    <rng:attribute name="for">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="expr">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="action-method">
        <rng:element name="action-method">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:element name="call">
                <rng:ref name="if-attr"/>
                <rng:attribute name="class">
                    <rng:data type="string"/>
                </rng:attribute>
                <rng:attribute name="method">
                    <rng:data type="string"/>
                </rng:attribute>
                <rng:optional>
                    <rng:attribute name="if">
                        <rng:notAllowed/>
                    </rng:attribute>
                </rng:optional>
            </rng:element>
        </rng:element>
    </rng:define>

    <rng:define name="action-script">
        <rng:element name="action-script">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:element name="script">
                <rng:attribute name="language">
                    <rng:choice>
                        <rng:value type="string">python</rng:value>
                    </rng:choice>
                </rng:attribute>
                <rng:optional>
                    <rng:attribute name="transactional">
                        <rng:data type="boolean"/>
                    </rng:attribute>
                </rng:optional>
                <rng:data type="string"/>
            </rng:element>
        </rng:element>
    </rng:define>

    <rng:define name="common-action-attr">
        <rng:ref name="if-attr"/>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="action-ws">
        <rng:element name="action-ws">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="action">
                    <rng:ref name="common-action-attr"/>
                    <rng:attribute name="template">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="engine">
                            <rng:choice>
                                <rng:value type="string">python</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="connect-timeout">
                    <rng:data type="int"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="read-timeout">
                    <rng:data type="int"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-import">
        <rng:element name="action-import">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="import">
                    <rng:optional>
                        <rng:attribute name="name">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="provider">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="file">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:oneOrMore>
            <rng:attribute name="config">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:element>
    </rng:define>

    <rng:define name="action-export">
        <rng:element name="action-export">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="export">
                    <rng:ref name="if-attr"/>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="template">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:optional>
                        <rng:attribute name="engine">
                            <rng:choice>
                                <rng:value type="string">python</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="attachment">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-report">
        <rng:element name="action-report">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:zeroOrMore>
                <rng:element name="param">
                    <rng:ref name="ActContext"/>
                </rng:element>
            </rng:zeroOrMore>
            <rng:attribute name="design">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:attribute name="output">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="format">
                    <rng:choice>
                        <rng:value type="string">xlsx</rng:value>
                        <rng:value type="string">pdf</rng:value>
                        <rng:value type="string">doc</rng:value>
                        <rng:value type="string">html</rng:value>
                        <rng:value type="string">xls</rng:value>
                        <rng:value type="string">odt</rng:value>
                        <rng:value type="string">docx</rng:value>
                        <rng:value type="string">ods</rng:value>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="attachment">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-group">
        <rng:element name="action-group">
            <rng:attribute name="name">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="action">
                    <rng:ref name="common-action-attr"/>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="layout-attr">
        <rng:optional>
            <rng:attribute name="helpLink">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="width">
                <rng:data type="string">
                    <rng:param name="pattern">((\*|mini|mid|large)|(\d+)(%|px|em)?)((:(\d+)(px|em)?){1,2})?</rng:param>
                </rng:data>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="css">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="groups">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="title">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="ExtraCollectionAttributes">
        <rng:optional>
            <rng:attribute name="x-tree-limit">
                <rng:data type="int"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="x-tree-field-title">
