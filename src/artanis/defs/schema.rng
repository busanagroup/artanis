            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="field">
        <rng:element name="field">
            <rng:attribute name="name"/>
            <rng:optional>
                <rng:attribute name="title"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showIf"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="type"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="label"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="expr"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="if"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hidden"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colSpan"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="height"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="canEdit"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onChange"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="required"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="form-view"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="grid-view"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="x-bind"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="canNew"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onSelect"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hideIf"/>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="panel-include">
        <rng:element name="panel-include">
            <rng:attribute name="view"/>
        </rng:element>
    </rng:define>

    <rng:define name="panel-related">
        <rng:element name="panel-related">
            <rng:attribute name="name"/>
            <rng:optional>
                <rng:attribute name="field"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colSpan"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="grid-view"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="form"/>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="panel">
        <rng:element name="panel">
            <rng:attribute name="name"/>
            <rng:optional>
                <rng:attribute name="sidebar"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colSpan"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="if"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="expr"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hidden"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="height"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hideIf"/>
            </rng:optional>
            <rng:zeroOrMore>
                <rng:choice>
                    <rng:ref name="panel-include"/>
                    <rng:ref name="panel"/>
                    <rng:ref name="field"/>
                    <rng:ref name="button-group"/>
                    <rng:ref name="button"/>
                    <rng:ref name="spacer"/>
                    <rng:ref name="panel-related"/>
                </rng:choice>
            </rng:zeroOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="form">
        <rng:element name="form">
            <rng:ref name="form-attr"/>
