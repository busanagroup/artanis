            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonlyIf"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colSpan"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showIf"/>
            </rng:optional>
            <rng:oneOrMore>
