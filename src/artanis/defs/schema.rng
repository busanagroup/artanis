                    <rng:value type="string">reference</rng:value>
                    <rng:value type="string">button</rng:value>
                    <rng:value type="string">datetime</rng:value>
                    <rng:value type="string">boolean</rng:value>
                    <rng:value type="string">string</rng:value>
                    <rng:value type="string">integer</rng:value>
                    <rng:value type="string">decimal</rng:value>
                    <rng:value type="string">enum</rng:value>
