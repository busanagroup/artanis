            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="showIf">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="hideIf">
