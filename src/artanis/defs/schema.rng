                        <rng:value type="string">black</rng:value>
                        <rng:value type="string">violet</rng:value>
                        <rng:value type="string">teal</rng:value>
                        <rng:value type="string">amber</rng:value>
                        <rng:value type="string">lightgreen</rng:value>
                        <rng:value type="string">brown</rng:value>
                        <rng:value type="string">deeppurple</rng:value>
                        <rng:value type="string">cyan</rng:value>
                        <rng:value type="string">grey</rng:value>
                        <rng:value type="string">red</rng:value>
                        <rng:value type="string">orange</rng:value>
                        <rng:value type="string">blue</rng:value>
                        <rng:value type="string">lightblue</rng:value>
