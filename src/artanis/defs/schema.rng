                <rng:attribute name="extension">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-group">
        <rng:element name="action-group">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="action">
                    <rng:ref name="common-action-attr"/>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="view">
        <rng:element name="view">
            <rng:attribute name="type"/>
            <rng:attribute name="name"/>
        </rng:element>
    </rng:define>

    <rng:define name="action">
        <rng:element name="action">
            <rng:attribute name="name"/>
            <rng:optional>
                <rng:attribute name="service"/>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title"/>
            </rng:optional>
            <rng:zeroOrMore>
                <rng:choice>
                    <rng:ref name="view"/>
                </rng:choice>
            </rng:zeroOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="call">
        <rng:element name="call">
            <rng:attribute name="class"/>
            <rng:optional>
                <rng:attribute name="method"/>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="alert">
        <rng:element name="alert">
            <rng:attribute name="message"/>
            <rng:optional>
                <rng:attribute name="if"/>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="attribute">
        <rng:element name="attribute">
            <rng:attribute name="name"/>
            <rng:optional>
                <rng:attribute name="if"/>
                <rng:attribute name="for"/>
                <rng:attribute name="expr"/>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-method">
        <rng:element name="action-method">
            <rng:ref name="service-attr"/>
            <rng:element name="call">
                <rng:ref name="if-attr"/>
                <rng:attribute name="class">
                    <rng:data type="string"/>
                </rng:attribute>
                <rng:attribute name="method">
                    <rng:data type="string"/>
                </rng:attribute>
                <rng:optional>
                    <rng:attribute name="if">
                        <rng:notAllowed/>
                    </rng:attribute>
                </rng:optional>
            </rng:element>
        </rng:element>
    </rng:define>

    <!-- anonymous5 -->
    <rng:define name="action-field-attr">
        <rng:ref name="if-attr"/>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="expr">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="copy">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="action-record">
        <rng:element name="action-record">
            <rng:ref name="module-attr"/>
            <rng:attribute name="service">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:oneOrMore>
                <rng:element name="field">
                    <rng:ref name="action-field-attr"/>
                </rng:element>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="search">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="ref">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="copy">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="saveIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:element>
    </rng:define>

    <rng:define name="action-validate">
        <rng:element name="action-validate">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:choice>
                    <rng:element name="error">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                    <rng:element name="alert">
                        <rng:ref name="error-attr"/>
                    </rng:element>
                    <rng:element name="info">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="action">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                    <rng:element name="notify">
                        <rng:ref name="error-attr"/>
                        <rng:optional>
                            <rng:attribute name="action">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="confirm-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                        <rng:optional>
                            <rng:attribute name="cancel-btn-title">
                                <rng:notAllowed/>
                            </rng:attribute>
                        </rng:optional>
                    </rng:element>
                </rng:choice>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <!-- anonymous16 -->
    <rng:define name="error-attr">
        <rng:ref name="if-attr"/>
        <rng:attribute name="message">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="action">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="confirm-btn-title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="cancel-btn-title">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <rng:define name="action-attrs">
        <rng:element name="action-attrs">
            <rng:ref name="service-attr"/>
            <rng:oneOrMore>
                <rng:element name="attribute">
                    <rng:ref name="if-attr"/>
                    <rng:attribute name="for">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                    <rng:attribute name="expr">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:oneOrMore>
        </rng:element>
    </rng:define>

    <rng:define name="search-filters">
        <rng:element name="search-filters">
            <rng:ref name="named-layout-attr"/>
            <rng:zeroOrMore>
                <rng:element name="field">
                    <rng:optional>
                        <rng:attribute name="selection">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="if">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="hidden">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="title">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="name">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
            <rng:zeroOrMore>
                <rng:element name="filter">
                    <rng:ref name="if-condition"/>
                    <rng:element name="domain">
                        <rng:data type="string"/>
                    </rng:element>
                    <rng:zeroOrMore>
                        <rng:element name="context">
                            <rng:attribute name="value">
                                <rng:data type="string"/>
                            </rng:attribute>
                            <rng:attribute name="name">
                                <rng:data type="string"/>
                            </rng:attribute>
                        </rng:element>
                    </rng:zeroOrMore>
                    <rng:optional>
                        <rng:attribute name="name">
                            <rng:data type="string"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:attribute name="title">
                        <rng:data type="string"/>
                    </rng:attribute>
                </rng:element>
            </rng:zeroOrMore>
            <rng:attribute name="service">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:element>
    </rng:define>

    <!-- anonymous2 -->
    <rng:define name="layout-attr">
        <rng:optional>
            <rng:attribute name="helpLink">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="width">
                <rng:data type="string">
                    <rng:param name="pattern">((\*|mini|mid|large)|(\d+)(%|px|em)?)((:(\d+)(px|em)?){1,2})?</rng:param>
                </rng:data>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="css">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="groups">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="title">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:optional>
            <rng:attribute name="id">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
    </rng:define>

    <!-- anonymous14 -->
    <rng:define name="named-layout-attr">
