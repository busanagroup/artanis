<?xml version="1.0" encoding="UTF-8"?>
<rng:grammar xmlns:rng="http://relaxng.org/ns/structure/1.0"
             datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

    <!-- ObjectViewAttributes -->
    <rng:define name="ArtanisAttributes">
        <rng:optional>
            <rng:attribute name="x-json-model">
                <rng:data type="string"/>
            </rng:attribute>
        </rng:optional>
        <rng:optional>
            <rng:attribute name="editable">
                <rng:data type="boolean"/>
            </rng:attribute>
        </rng:optional>
        <rng:attribute name="model">
            <rng:data type="string"/>
        </rng:attribute>
        <rng:attribute name="name">
            <rng:data type="string"/>
        </rng:attribute>
    </rng:define>

    <rng:define name="GridWidgets">
        <rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="field">
                    <rng:ref name="panel-field-attr"/>
                    <rng:optional>
                        <rng:element name="grid">
                            <rng:ref name="grid-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:element name="form">
                            <rng:ref name="form-attr"/>
                            <rng:optional>
                                <rng:attribute name="editable">
                                    <rng:data type="boolean"/>
                                </rng:attribute>
                            </rng:optional>
                        </rng:element>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="aggregate">
                            <rng:choice>
                                <rng:value type="string">avg</rng:value>
                                <rng:value type="string">min</rng:value>
                                <rng:value type="string">max</rng:value>
                                <rng:value type="string">sum</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="sortable">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="massUpdate">
                            <rng:data type="boolean"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="canSelect">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="edit-window">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="summary-view">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="colOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowSpan">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="rowOffset">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="showTitle">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="height">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="depends">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-call-onSave">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-copy">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-reload">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-can-export">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-labels">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-icons">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="x-show-bars">
                            <rng:notAllowed/>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="button">
                    <rng:ref name="GridButton"/>
                </rng:element>
            </rng:choice>
        </rng:choice>
    </rng:define>

    <rng:define name="ExtendGridItems">
        <rng:choice>
            <rng:ref name="GridWidgets"/>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="toolbar">
                    <rng:ref name="Toolbar"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="menubar">
                    <rng:ref name="Menubar"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="menu">
                    <rng:ref name="MenubarMenu"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="item">
                    <rng:ref name="MenubarMenuItem"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="divider">
                    <rng:ref name="MenubarMenuDivider"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="help">
                    <rng:ref name="Help"/>
                </rng:element>
            </rng:choice>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="hilite">
                    <rng:ref name="Hilite"/>
                </rng:element>
            </rng:choice>
        </rng:choice>
    </rng:define>

    <rng:define name="Button">
        <rng:ref name="button-attr"/>
    </rng:define>

    <rng:define name="Separator">
        <rng:group>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="help">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonlyIf">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="if-module">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="if">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="id">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hidden">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="css">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="height">
                    <rng:ref name="css-height"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="width">
                    <rng:ref name="css-width"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hideIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="depends">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="rowOffset">
                    <rng:ref name="ResponsiveNumber"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="rowSpan">
                    <rng:ref name="ResponsiveNumber"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colOffset">
                    <rng:ref name="ResponsiveNumber"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colSpan">
                    <rng:ref name="ResponsiveNumber"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="Spacer">
        <rng:group>
            <rng:ref name="field-status-attr"/>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="hidden">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="help">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonlyIf">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="PanelMail">
        <rng:group>
            <rng:ref name="panel-attr"/>
            <rng:choice>
                <rng:notAllowed/>
                <rng:element name="mail-messages">
                    <rng:optional>
                        <rng:attribute name="limit">
                            <rng:data type="int"/>
                        </rng:attribute>
                    </rng:optional>
                    <rng:optional>
                        <rng:attribute name="filter">
                            <rng:choice>
                                <rng:value type="string">all</rng:value>
                                <rng:value type="string">notification</rng:value>
                                <rng:value type="string">comment</rng:value>
                            </rng:choice>
                        </rng:attribute>
                    </rng:optional>
                </rng:element>
            </rng:choice>
        </rng:group>
    </rng:define>

    <rng:define name="Panel">
        <rng:group>
            <rng:ref name="panel-attr"/>
            <rng:optional>
                <rng:choice>
                    <rng:notAllowed/>
                    <rng:element name="menu">
                        <rng:oneOrMore>
                            <rng:element name="item">
                                <rng:ref name="MenubarMenuItem"/>
                            </rng:element>
                        </rng:oneOrMore>
                    </rng:element>
                </rng:choice>
            </rng:optional>
            <rng:oneOrMore>
                <rng:ref name="PanelItems"/>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="canCollapse">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="collapseIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="icon">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="icon-background">
                    <rng:choice>
                        <rng:choice>
                            <rng:value type="string">pink</rng:value>
                            <rng:value type="string">green</rng:value>
                            <rng:value type="string">bluegrey</rng:value>
                            <rng:value type="string">deeporange</rng:value>
                            <rng:value type="string">lime</rng:value>
                            <rng:value type="string">yellow</rng:value>
                            <rng:value type="string">black</rng:value>
                            <rng:value type="string">violet</rng:value>
                            <rng:value type="string">teal</rng:value>
                            <rng:value type="string">amber</rng:value>
                            <rng:value type="string">lightgreen</rng:value>
                            <rng:value type="string">brown</rng:value>
                            <rng:value type="string">deeppurple</rng:value>
                            <rng:value type="string">cyan</rng:value>
                            <rng:value type="string">grey</rng:value>
                            <rng:value type="string">red</rng:value>
                            <rng:value type="string">orange</rng:value>
                            <rng:value type="string">blue</rng:value>
                            <rng:value type="string">lightblue</rng:value>
                            <rng:value type="string">white</rng:value>
                            <rng:value type="string">olive</rng:value>
                            <rng:value type="string">purple</rng:value>
                            <rng:value type="string">indigo</rng:value>
                        </rng:choice>
                        <rng:data type="string">
                            <rng:param name="pattern">#[\dA-Fa-f]{6}([\dA-Fa-f][\dA-Fa-f])?</rng:param>
                        </rng:data>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="FormInclude">
        <rng:group>
            <rng:ref name="if-condition"/>
            <rng:attribute name="view">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="from">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="PanelDashlet">
        <rng:ref name="panel-dash-attr"/>
    </rng:define>

    <rng:define name="PanelRelated">
        <rng:group>
            <rng:ref name="panel-attr"/>
            <rng:zeroOrMore>
                <rng:choice>
                    <rng:notAllowed/>
                    <rng:element name="field">
                        <rng:ref name="PanelField"/>
                    </rng:element>
                </rng:choice>
            </rng:zeroOrMore>
            <rng:zeroOrMore>
                <rng:choice>
                    <rng:notAllowed/>
                    <rng:element name="button">
                        <rng:ref name="Button"/>
                    </rng:element>
                </rng:choice>
            </rng:zeroOrMore>
            <rng:optional>
                <rng:attribute name="cols">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colWidths">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="itemSpan">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="stacked">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:attribute name="field">
                <rng:data type="string"/>
            </rng:attribute>
            <rng:optional>
                <rng:attribute name="editable">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="required">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="requiredIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="validIf">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="orderBy">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="groupBy">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onNew">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onChange">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onCopy">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onDelete">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="canMove">
                    <rng:data type="boolean"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="x-selector">
                    <rng:choice>
                        <rng:value type="string">checkbox</rng:value>
                        <rng:value type="string">none</rng:value>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="widget">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:ref name="RelationalAttributes"/>
            <rng:ref name="ExtraAttributes"/>
        </rng:group>
    </rng:define>

    <rng:define name="PanelTabs">
        <rng:group>
            <rng:ref name="panel-attr"/>
            <rng:oneOrMore>
                <rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="panel">
                            <rng:ref name="Panel"/>
                        </rng:element>
                    </rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="panel-related">
                            <rng:ref name="PanelRelated"/>
                        </rng:element>
                    </rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="panel-dashlet">
                            <rng:ref name="PanelDashlet"/>
                        </rng:element>
                    </rng:choice>
                    <rng:choice>
                        <rng:notAllowed/>
                        <rng:element name="panel-include">
                            <rng:ref name="FormInclude"/>
                        </rng:element>
                    </rng:choice>
                </rng:choice>
            </rng:oneOrMore>
            <rng:optional>
                <rng:attribute name="stacked">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="cols">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="colWidths">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="itemSpan">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showFrame">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="help">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="onTabSelect">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="x-row-height">
                    <rng:data type="int"/>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <!-- anonymous17 -->
    <rng:define name="help-layout-attr">
        <rng:mixed>
            <rng:ref name="field-status-attr"/>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="title">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonlyIf">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="help">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
        </rng:mixed>
    </rng:define>

    <rng:define name="Help">
        <rng:group>
            <rng:ref name="help-layout-attr"/>
            <rng:optional>
                <rng:attribute name="variant">
                    <rng:choice>
                        <rng:value type="string">success</rng:value>
                        <rng:value type="string">warning</rng:value>
                        <rng:value type="string">danger</rng:value>
                        <rng:value type="string">info</rng:value>
                    </rng:choice>
                </rng:attribute>
            </rng:optional>
        </rng:group>
    </rng:define>

    <rng:define name="Label">
        <rng:group>
            <rng:ref name="field-status-attr"/>
            <rng:optional>
                <rng:attribute name="name">
                    <rng:data type="string"/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="showTitle">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
                <rng:attribute name="readonly">
                    <rng:notAllowed/>
                </rng:attribute>
            </rng:optional>
            <rng:optional>
